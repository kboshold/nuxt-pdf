{
  "name": "@sidebase/nuxt-pdf",
  "version": "1.0.0-alpha.0",
  "description": "A Nuxt 3 module to create Server Side rendered PDFs",
  "repository": "@sidebase/nuxt-pdf",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./components": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt-module-build prepare && nuxi prepare playground",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "pnpm run build --stub && pnpm run prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build",
    "release": "pnpm run lint && pnpm run prepack && changelogen --release --push && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest"
  },
  "dependencies": {
    "@nuxt/kit": "^3.10.1",
    "cheerio": "^1.0.0",
    "h3": "^1.10.1",
    "jsesc": "^3.0.0",
    "pagedjs": "^0.4.3",
    "puppeteer-core": "^24.0.0"
  },
  "peerDependencies": {
    "@tailwindcss/typography": ">=0.5.0",
    "puppeteer": "^24.0.0",
    "tailwindcss": ">=4.2.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^0.2.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^3.10.1",
    "@nuxt/test-utils": "^3.17.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.11.16",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^8.56.0",
    "nuxt": "^3.10.1",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.2.6"
  }
}
