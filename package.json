{
  "name": "@sidebase/nuxt-pdf",
  "version": "1.0.0-alpha.0",
  "description": "A Nuxt 3 module to create Server Side rendered PDFs",
  "repository": "@sidebase/nuxt-pdf",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./components": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt-module-build prepare --rootDir . && cd playground && nuxi prepare",
    "dev": "cd playground && nuxi dev",
    "dev:build": "cd playground && nuxi build",
    "dev:prepare": "pnpm run build --stub && pnpm run prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build",
    "release": "pnpm run lint && pnpm run prepack && changelogen --release --push && pnpm publish && git push --follow-tags",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings && eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "typecheck": "cd playground && nuxi typecheck",
    "test": "vitest"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "cheerio": "^1.2.0",
    "h3": "^2.0.0",
    "jsesc": "^3.1.0",
    "pagedjs": "^0.4.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "puppeteer-core": "^24.40.0"
  },
  "peerDependencies": {
    "@tailwindcss/typography": ">=0.5.0",
    "puppeteer": "^24.0.0",
    "tailwindcss": ">=4.2.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "happy-dom": "^20.8.9",
    "nuxt": "^4.4.2",
    "oxlint": "^1.57.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  }
}
